{
    "manifest_version": 3,
    "name": "TV Series Episode Tracker",
    "version": "1.0",
    "description": "Track TV series episodes and increment automatically on watched pages.",
    "permissions": ["storage", "tabs", "notifications"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
    }
    ],
    "options_page": "options.html"
}
